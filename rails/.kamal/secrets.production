SECRETS=$(kamal secrets fetch --account cflipse@gmail.com --adapter bitwarden --from "cast.production" master_key litestream_key_id litestream_key_secret)

RAILS_MASTER_KEY=$(kamal secrets extract master_key $SECRETS)
LITESTREAM_ACCESS_KEY_ID=$(kamal secrets extract litestream_key_id $SECRETS)
LITESTREAM_SECRET_ACCESS_KEY=$(kamal secrets extract litestream_key_secret $SECRETS)
