#!/usr/bin/env ruby
# frozen_string_literal: true

# Push an edited front-door Caddyfile to the VM and hot-reload Caddy --
# no image rebuild, no container restart, no dropped connections. Use
# this for routing/TLS changes in deploy/caddy/Caddyfile itself. For a
# Dockerfile/plugin change or a Caddy version bump, use
# deploy/update-caddy instead.
#
#   deploy/reload-caddy you@your-droplet-ip

require_relative "lib/shell"
include Shell

host = ARGV[0] or abort "usage: deploy/reload-caddy user@host"

CONTEXT = "vm"
CADDY_SERVICE = "caddy"
SCRIPT_DIR = __dir__
DOCKER = ["docker", "--context", CONTEXT].freeze

log "Copying Caddyfile to #{host}:/srv/cast/caddy/Caddyfile"
run("ssh", host, "mkdir -p /srv/cast/caddy/branches")
run("scp", File.join(SCRIPT_DIR, "caddy", "Caddyfile"), "#{host}:/srv/cast/caddy/Caddyfile")

container_id = capture(*DOCKER, "ps", "--filter", "name=#{CADDY_SERVICE}", "--format", "{{.ID}}")
               .lines(chomp: true).first
unless container_id
  abort "No running #{CADDY_SERVICE} container found -- deploy it first with deploy/update-caddy"
end

log "Reloading Caddy config (zero-downtime)"
run(*DOCKER, "exec", container_id, "caddy", "reload", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile")

log "Reload complete"
