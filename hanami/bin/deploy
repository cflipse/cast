#!/usr/bin/env ruby

require "bundler/setup"
require "dry/cli"
require "net/ssh"
require "net/scp"

require "open3"
require "pathname"
require "erb"


module Deploy
  module Config
    extend self

    module Production
      extend self

      def name = "production"
      def vault = "cast.production"
      def slug = "production"
      def domain = "cast.athas.org"
      def stack = "cast-production"
    end

    Staging = Data.define(:name, :slug) do
      def vault = "cast.staging"
      def domain = "#{slug}.cast.athas.org"
      def stack = "cast-#{slug}"
    end

    def self.for(name, production: false)
      return Production if production

      slug = Git.branch.downcase.gsub(/[^[:alnum:]]/, '-')
      raise "unknown target" if slug.empty?

      Staging.new(name, slug)
    end
  end

  module Git
    extend self
    def branch = git("branch", "--show-current").strip
    def sha = git("rev-parse", "--short", "HEAD").strip

    private
    def git(*) = Shell.read("git", "-C", Shell.root, *)
  end

  module Shell
    module_function

    def log(message) = puts "==> #{message}"

    def run(*cmd, **opts)
      puts "+ #{cmd.join(' ')}"
      Shell.read(*cmd, **opts)
    end

    def read(*cmd, **opts)
      out, err, status = Open3.capture3(*cmd, **opts)
      raise "command failed #{cmd.join(' ')} : #{err}" unless status.success?
      out
    end

    def stream(*cmd, stdin_data:)
      puts "+ #{cmd.join(' ')}"

      r, w = IO.pipe
      pid = Process.spawn(*cmd, in: r)
      r.close
      w.write(stdin_data)
      w.close
      _, status = Process.wait2(pid)

      raise "command failed: #{cmd.join(' ')}" unless status.success?
    end

    def tail(*cmd, &)
      IO.popen(cmd, err: [:child, :out]) do |io|
        io.each_line(&)
      end
    end

    def root(*parts) = Pathname.new(__dir__).join("..", *parts).to_s
  end

  module Remote
    extend self

    PATH = "/srv/cast".freeze

    def path(sub) = Pathname.new(PATH).join(sub)

    def init(conn)
      conn.exec!("sudo mkdir -p #{PATH} && sudo chown \"$(id -u):$(id -g)\" #{PATH}")

      mkdir(conn, "caddy/branches")
    end

    def mkdir(conn, subdir)
      conn.exec!("mkdir -p #{path subdir}")
    end

    def rm(conn, target)
      raise "Refusing to delete an empty target" if target.to_s.strip.empty?

      conn.exec!("rm -rf #{path target}")
    end

    def upload(conn, io, dest)
      Shell.log "uploading file to #{dest}"
      path = Remote.path(dest)

      conn.scp.upload! io, path.to_s
    end
  end

  module SSH
    extend self

    def connect(host, &)
      user, hostname = host.split("@", 2)
      user, hostname = "root", user if hostname.nil?

      Net::SSH.start(hostname, user, &)
    end

    def tunnel(conn, remote_port)
      port = conn.forward.local(0, "localhost", remote_port)

      running = true
      # keep the connection flowing in the background
      worker = Thread.new { conn.loop(0.1) { running }}

      begin
        yield port
      ensure
        running = false
        worker.value
      end
    end

    def public_ip(conn)
      conn.exec!("curl -s http://169.254.169.254/metadata/v1/interfaces/public/0/ipv4/address").strip
    end
  end

  module Caddy
    extend self

    CADDY_SERVICE = "caddy".freeze

    def add_domain(conn, config)
      caddy = Template.render("deploy/branch.caddy.erb",
        domain: config.domain,
        deployment: config.slug,
      )

      Shell.log "Updating #{config.slug}.caddy file"

      Remote.upload conn, StringIO.new(caddy), 
        "caddy/branches/#{config.slug}.caddy"
    end

    def drop_domain(conn, config)
      Remote.rm conn, "caddy/branches/#{config.slug}.caddy"
    end

    def reload(swarm)
      swarm.exec_in CADDY_SERVICE, "reload",
        "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"
    end

    def start(swarm, remote_image)
      swarm.start_service CADDY_SERVICE, remote_image,
        "--publish", "published=80,target=80,mode=host",
        "--publish", "published=443,target=443,mode=host",
        "--mount", "type=volume,source=caddy-data,destination=/data",
        "--mount", "type=volume,source=caddy-config,destination=/config",
        "--mount", "type=bind,source=#{Remote.path 'caddy/Caddyfile'},destination=/etc/caddy/Caddyfile",
        "--mount", "type=bind,source=#{Remote.path 'caddy/branches'},destination=/etc/caddy/branches"
    end

    def push(ssh)
      dir = Shell.root("deploy", "caddy")
      Shell.log "Ensuring Caddyfile is current"

      Remote.upload(ssh, File.join(dir, "Caddyfile"), "caddy/")
    end

    def deploy(swarm)
      local = Builder.caddy
      remote = ""

      SSH.connect(swarm.host) do |ssh|
        push(ssh)
        remote = Registry.publish(ssh, local)
      end

      Caddy.start(swarm, remote)

      Shell.log "Caddy update complete"
    end
  end

  module Docker
    extend self

    def set_context(host, context)
      # Always reset: recreating a context is cheap, and unconditionally
      # doing so avoids a stale context silently pointing at a server that
      # no longer exists (e.g. after swapping in a replacement droplet).
      run("context", "rm", "-f", context)

      log "Creating docker context #{context} -> #{host}"
      run("context", "create", context, "--docker", "host=ssh://#{host}")
    end

    def install(ssh)
      if ssh.exec!("command -v docker").exitstatus == 0
        log "Docker already installed on #{ssh.host}, skipping"
      else
        log "Installing Docker on #{ssh.host}"
        ssh.exec! "curl -fsSL https://get.docker.com | sh"
      end
    end

    def publish(local, image)
      run "tag", local, image
      run "push", image 
    ensure
      run "rmi", image
    end

    def build(tag, *args) = run("build", "-t", tag, *args)

    private

    def run(*cmd, **opts) = Shell.run("docker", *cmd, **opts)
    def log(...) = Shell.log(...)
  end

  module Stack
    extend self

    def prepare(conn, config)
      Remote.mkdir(conn, "#{config.slug}/data")
      Remote.mkdir(conn, "#{config.slug}/redis")
    end

    def purge(conn, config)
      Remote.rm(conn, config.slug)
    end
  end

  module Builder
    extend self

    def app(config)
      name = local_image("cast-#{config.slug}")

      Shell.log("Building docker image locally: #{name}")
      Docker.build(name, "--target", "production", ".")

      name
    end

    def caddy
      dir = Shell.root("deploy", "caddy")
      name = local_image("caddy")

      # Build on THIS machine, not the VM's daemon, so the host never spends
      # its own CPU/disk compiling images.
      Shell.log "Building front-door Caddy image locally (#{name})"
      Docker.build(name, dir)

      name
    end

    private

    def local_image(name) = [name, Git.sha].join(":")
  end

  module Registry
    extend self

    REGISTRY_SERVICE = "registry".freeze
    REGISTRY_PORT = 5555

    def publish(ssh, local)
      SSH.tunnel(ssh, REGISTRY_PORT) do |port|
        image = "localhost:#{port}/#{local}"

        Docker.publish(local, image)
      end

      # return the image tag for the remote registry image
      "localhost:#{REGISTRY_PORT}/#{local}"
    end

    def create(swarm)
      swarm.start_service REGISTRY_SERVICE, "registry:2",
        "--publish", "published=#{REGISTRY_PORT},target=5000,mode=host",
        "--constraint", "node.role==manager",
        "--mount", "type=volume,source=registry-data,destination=/var/lib/registry"
    end
  end

  module Template
    extend self

    def render(path, **fields) = erb(path).result_with_hash(**fields)
    def bind(path, binding) = erb(path).result(binding)

    private

    def erb(path)
      template = File.read(Shell.root(path))

      ERB.new(template, trim_mode: "-")
    end
  end

  Swarm = Data.define(:context) do
    NETWORK = "swarm-network"

    def init(ip)
      state = read("info", "--format", "{{.Swarm.LocalNodeState}}").strip

      if state == "active"
        log "Already part of a swarm, skipping swarm init"
      else
        log "Initializing swarm"
        run("swarm", "init", "--advertise-addr", ip)
      end
    end

    def host
      Shell.read("docker", "context", "inspect", context,
        "--format", "{{.Endpoints.docker.Host}}"
      ).strip.split("//",2).last
    end

    def deploy_stack(name, template, **fields)
      data = Template.render(template,
        root_dir: Remote::PATH,
        network: NETWORK,
        **fields
      )

      Shell.stream "docker", "--context", context, "stack", "deploy",
        "--compose-file", "-", "--detach=false", name, stdin_data: data
    end

    def create_overlay_network
      if running?("network", NETWORK)
        log "Network #{NETWORK} already exists, skipping"
      else
        log "Creating overlay network #{NETWORK}"
        run("network", "create", "--driver", "overlay", "--attachable", NETWORK)
      end
    end

    def exec_in(name, *args)
      container_id = read("ps", "--filter", "name=#{name}", "--format", "{{.ID}}")
        .lines(chomp: true).first

      abort "No running #{name}.  Deploy it first" unless container_id

      log "running in #{name}: #{args.join(' ')} "
      run "exec", container_id, name, *args

      log "complete"
    end

    def start_service(name, image, *args)
      if running?("service", name)
        Shell.log "Rolling out #{image} to existing #{name} service"
        run "service", "update", name, "--image", image
      else
        Shell.log "Creating #{name} service"

        run "service", "create",
          "--name", name,
          "--network", NETWORK,
          *args,
          image
      end
    end

    def secrets(item)
      existing = read "secret", "ls",
        "--filter", "label=cast.secrets=#{item}",
        "--format", "{{.Name}}\t{{.Labels}}"

      secrets = existing.lines(chomp: true).to_h do |line|
        sec, labels = line.split("\t", 2)
        [sec, labels.split(",").to_h { it.split("=", 2) }]
      end

      [secrets.keys.max, secrets]
    end

    def secret(...) = secrets(...).first

    def update_secret(item, hex, data)
      name = "#{item.gsub('.', '-')}-#{Time.now.utc.iso8601.gsub(/[:-]/, '')}"
      log "Creating secret #{name}"

      read "secret", "create", name,
        "--label", "cast.secrets=#{item}",
        "--label", "cast.hash=#{hex}",
        "-", stdin_data: data

      name
    end

    def remove(stack) = run "stack", "rm", stack

    private

    def run(*cmd, **opts)  = Shell.run("docker", "--context", context, *cmd, **opts)
    def read(*args, **opts) = Shell.read("docker", "--context", context, *args, **opts)
    def log(...) = Shell.log(...)

    def running?(kind, name)
      read(kind, "ls", "--format", "{{.Name}}").lines(chomp: true).include?(name)
    end
  end

  module CLI
    module Commands
      extend Dry::CLI::Registry

      class DeployCaddy < Dry::CLI::Command
        desc "deploy a new caddy image"

        option :context, default: "cast", desc: "local docker context"

        def call(context:)
          swarm = Swarm.new(context)
          Caddy.deploy(swarm)
        end
      end

      class ReloadCaddy < Dry::CLI::Command
        desc "reload a caddy configuration"

        option :context, default: "cast", desc: "local docker context"

        def call(context:)
          swarm = Swarm.new(context)

          SSH.connect(swarm.host) do |ssh|
            Caddy.push(ssh)
          end

          Caddy.reload(swarm)
        end
      end

      class Teardown < Dry::CLI::Command
        option :context, default: "cast", desc: "local docker context"

        def call(context:)
          config = Config.for("staging")
          swarm = Swarm.new(context)

          swarm.remove(config.stack)

          SSH.connect(swarm.host) do |conn|
            Caddy.drop_domain(conn, config)
            Stack.purge(conn, config)
          end

          Caddy.reload(swarm)
        end
      end

      class Secrets < Dry::CLI::Command
        KEY = "cast.hash"

        desc "add secrets to docker swarm"

        option :template, default: "deploy/env.erb", desc: "ERB env template"
        option :context, default: "cast", desc: "local docker context"
        option :dry_run, type: :boolean, default: false, desc: "print keys only, create nothing", aliases: ["-n"]

        def prepare
          require "shellwords"
          require "digest"
          require "erb"
          require "json"
          require "time"
        end

        def call(template:, dry_run:, context:)
          prepare

          config = Config.for('staging')
          swarm = Swarm.new(context)

          fields = fetch_fields(config.vault)
          rendered = Template.bind(template, Renderer.new(fields).binding_for_erb)

          hex = Digest::SHA256.hexdigest(rendered)[..16]

          current, secrets = swarm.secrets(config.vault)
          exists = secrets.dig(current, KEY) == hex

          if dry_run
            puts "==> #{hex}"
            rendered.each_line { |line| puts line.sub(/=.*/m, "=<masked>") unless line.start_with?("#") || line.strip.empty? }

            puts "\n==> exists upstream #{current}" if exists
            return
          end

          name = current
          if exists
            Shell.log "Secret #{current} (#{hex}) already exists, skipping"
          else
            name = swarm.update_secret(config.vault, hex, rendered)
          end

          puts "ENV_SECRET=#{name}"
        end

        private

        Renderer = Data.define(:fields) do
          def secret(name) = fields.fetch(name.to_s) { raise KeyError, "Bitwarden item has no custom field #{name.inspect}" }
          def sh(value) = value.to_s.shellescape
          def binding_for_erb = binding
        end

        def fetch_fields(item)
          resp = IO.popen(["bw", "get", "item", item], &:read)
          raise "unable to read secrets" unless Process.last_status.success?

          json = JSON.parse resp

          (json["fields"] || []).to_h { |f| [f["name"], f["value"]] }
        end
      end

      class DeployDocker < Dry::CLI::Command
        desc "deploy the current branch"

        option :context, default: "cast", desc: "local docker context"

        def call(context:)
          config = Config.for('staging')
          swarm = Swarm.new(context)

          local = Builder.app(config)
          remote = ""

          SSH.connect(swarm.host) do |conn|
            Stack.prepare(conn, config)

            remote = Registry.publish(conn, local)

            Caddy.add_domain(conn, config)
          end

          swarm.deploy_stack(config.stack, "deploy/stack.yml.erb",
            deployment: config.slug,
            image: remote,
            env_secret: swarm.secret(config.vault),
          )

          Caddy.reload(swarm)
        end
      end

      class TailLogs < Dry::CLI::Command
        option :context, default: "cast", desc: "local docker context"
        option :follow, default: false, type: :boolean, aliases: ["-f"]
        option :service, default: "app"
        option :tail, default: "200", type: :string, aliases: ["-t"]
        option :since, default: "10m", aliases: ["-s"]


        def call(context:, follow:, service:, tail:, since:)
          config = Config.for("staging")

          cmd = ["docker", "--context", context, "service", "logs", "--timestamps",
                 "--tail", tail, "--since", since, "#{config.stack}_#{service}"]
          cmd << "--follow" if follow

          Shell.tail(*cmd)  { |l| puts l unless l.include?('"path":"/up"') }
        end
      end

      class Version < Dry::CLI::Command
        desc "show current version"
        def call(*) = puts "0.1.0"
      end

      class Bootstrap < Dry::CLI::Command
        desc "set up a new server"

        argument :host, required: true, desc: "ssh user@host"
        option :context, default: "cast", desc: "local docker context"

        def call(host:, context:)
          Docker.set_context(host, context)
          swarm = Swarm.new(context)
          ip = ""

          SSH.connect host do |conn|
            Remote.init(conn)
            Docker.install(conn)
            ip = SSH.public_ip(conn)
          end

          swarm.init(ip)
          swarm.create_overlay_network

          Registry.create(swarm)
          Caddy.deploy(swarm)
        end
      end

      register "version", Version, aliases: ["v", "-v", "--version"]
      register "bootstrap", Bootstrap
      register "deploy", DeployDocker
      register "caddy update", DeployCaddy
      register "caddy reload", ReloadCaddy
      register "secrets sync", Secrets
      register "logs", TailLogs
      register "teardown", Teardown
    end
  end
end

Dry::CLI.new(Deploy::CLI::Commands).call
# vim:syntax=ruby
