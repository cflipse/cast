#!/usr/bin/env ruby

require "bundler/setup"
require "dry/cli"
require "open3"
require "pathname"

module Deploy
  module CLI
    module Commands
      extend Dry::CLI::Registry

      class Version < Dry::CLI::Command
        desc "show current version"
        def call(*) = puts "0.1.0"
      end

      class Bootstrap < Dry::CLI::Command
        desc "set up a new server"

        argument :host, required: true, desc: "ssh user@host"
        option :context, default: "cast", desc: "local docker context"

        def call(host:, context:, **)
          Shell.log "Creating /srv/cast"
          Shell.run("ssh", host, 'sudo mkdir -p /srv/cast && sudo chown "$(id -u):$(id -g)" /srv/cast')

          SetupDocker.new.call(host:, context:)
          ::DeployCaddy.new.call(host:, context:, port: 5555)
        end
      end

      class ReloadCaddy < Dry::CLI::Command
        desc "reload a caddy configuration"

        argument :host, required: true, desc: "ssh user@host"
        option :context, default: "cast", desc: "local docker context"

        def call(host:, context:)
          ::ReloadCaddy.new.call(host:, context:)
        end
      end

      class DeployCaddy < Dry::CLI::Command
        desc "deploy a new caddy image"

        argument :host, required: true, desc: "ssh user@host"
        option :context, default: "cast", desc: "local docker context"

        def call(host:, context:)
          ::DeployCaddy.new.call(host:, context:, port: 555)
        end
      end

      register "version", Version, aliases: ["v", "-v", "--version"]
      register "bootstrap", Bootstrap
      register "caddy deploy", DeployCaddy
      register "caddy reload", ReloadCaddy
    end
  end
end

module Shell
  module_function

  def log(message) = puts "==> #{message}"
  def run(*cmd)
    puts "+ #{cmd.join(' ')}"
    system(*cmd) || raise("command failed: #{cmd.join(' ')}")
  end

  def success?(*cmd) = system(*cmd, out: File::NULL, err: File::NULL)

  def capture(*cmd)
    out, status = Open3.capture2(*cmd)
    raise "command failed: #{cmd.join(' ')}" unless status.success?

    out
  end
end

class SetupDocker < Dry::CLI::Command
  include Shell

  argument :host, required: true, desc: "ssh user@host"
  option :context, default: "cast", desc: "local docker context"

  def call(host:, context:)
    docker = ["docker", "--context", context]

    ip = public_ip(host)
    network = "swarm-network"

    install_docker(host)
    create_docker_context(host, context)

    docker_swarm_init(docker, ip)
    create_overlay_network(docker, network)
    deploy_registry(docker, network, 5555)
  end

  private

  def public_ip(host)
    capture("ssh", host, "curl -s http://169.254.169.254/metadata/v1/interfaces/public/0/ipv4/address").strip
  end

  def install_docker(host)
    if success?("ssh", host, "command -v docker")
      log "Docker already installed on #{host}, skipping"
    else
      log "Installing Docker on #{host}"
      run("ssh", host, "curl -fsSL https://get.docker.com | sh")
    end
  end

  def create_docker_context(host, context)
    if success?("docker", "context", "inspect", context)
      log "Docker context #{context} already exists, skipping"
    else
      log "Creating docker context #{context} -> #{host}"
      run("docker", "context", "create", context, "--docker", "host=ssh://#{host}")
    end
  end

  def docker_swarm_init(docker, ip)
    swarm_state = capture(*docker, "info", "--format", "{{.Swarm.LocalNodeState}}").strip
    if swarm_state == "active"
      log "Already part of a swarm, skipping swarm init"
    else
      log "Initializing swarm"
      run(*docker, "swarm", "init", "--advertise-addr", ip)
    end
  end

  def create_overlay_network(docker, name)

    networks = capture(*docker, "network", "ls", "--format", "{{.Name}}").lines(chomp: true)
    if networks.include?(name)
      log "Network #{name} already exists, skipping"
    else
      log "Creating overlay network #{name}"
      run(*docker, "network", "create", "--driver", "overlay", "--attachable", name)
    end
  end

  def deploy_registry(docker, network, port)
    services = capture(*docker, "service", "ls", "--format", "{{.Name}}").lines(chomp: true)
    if services.include?("registry")
      log "Service registry already running, skipping"
    else
      log "Deploying registry on 127.0.0.1:#{port}"
      run(*docker, "service", "create",
          "--name", "registry",
          "--network", network,
          "--publish", "published=#{port},target=5000,mode=host",
          "--constraint", "node.role==manager",
          "--mount", "type=volume,source=registry-data,destination=/var/lib/registry",
          "registry:2")
    end
  end
end

class DeployCaddy
  include Shell

  def call(host:, context:, port:)
    network = "swarm-network"
    caddy_image = image_tag(port)

    build_caddy(host, caddy_image)
    publish(host, port, caddy_image)
    start_caddy(context, network, caddy_image)

    log "Caddy update complete"
  end

  private

  # Tag by content (git SHA, same convention bin/deploy uses for app
  # images) so every build gets a distinct tag. A reused static tag (e.g.
  # caddy:bootstrap) makes `docker service update --image` a silent no-op,
  # since Swarm only notices a change when the tag itself differs.
  def image_tag(port)
    dir = Pathname.join(__dir__, "../").to_s

    tag = begin
      capture("git", "-C", dir, "rev-parse", "--short", "HEAD").strip
    rescue StandardError
      Time.now.to_i.to_s
    end

    "localhost:#{port}/caddy:#{tag}"
  end

  def build_caddy(host, tag)
    dir = Pathname.join(__dir__, "../", "deploy", "caddy").to_s

    # Build on THIS machine, not the VM's daemon, so the host never spends
    # its own CPU/disk compiling images.
    log "Building front-door Caddy image locally (#{tag})"
    run("docker", "build", "-t", tag, dir)

    log "Ensuring /srv/cast/caddy/branches exists and Caddyfile is current"
    run("ssh", host, "mkdir -p /srv/cast/caddy/branches")
    run("scp", File.join(dir, "Caddyfile"), "#{host}:/srv/cast/caddy/Caddyfile")
  end

  def publish(host, port, caddy_image)
    log "Tunneling to the registry and pushing"
    tunnel_pid = Process.spawn("ssh", "-NL", "#{port}:localhost:#{port}", host)
    begin
      sleep 1 # give the tunnel a moment to come up before pushing through it
      run("docker", "push", caddy_image)
    ensure
      Process.kill("TERM", tunnel_pid)
      Process.wait(tunnel_pid)
    end
  end

  def start_caddy(context, network, caddy_image)
    docker = ["docker", "--context", context]
    services = capture(*docker, "service", "ls", "--format", "{{.Name}}").lines(chomp: true)
    if services.include?("caddy")
      log "Rolling out #{caddy_image} to existing caddy service"
      run(*docker, "service", "update", "--image", caddy_image, "caddy")
    else
      log "Creating caddy service"
      run(*docker, "service", "create",
          "--name", "caddy",
          "--network", network,
          "--publish", "published=80,target=80",
          "--publish", "published=443,target=443",
          "--mount", "type=volume,source=caddy-data,destination=/data",
          "--mount", "type=volume,source=caddy-config,destination=/config",
          "--mount", "type=bind,source=/srv/cast/caddy/Caddyfile,destination=/etc/caddy/Caddyfile",
          "--mount", "type=bind,source=/srv/cast/caddy/branches,destination=/etc/caddy/branches",
          caddy_image)
    end
  end
end

class ReloadCaddy
  include Shell

  def call(host:, context:)
    docker = ["docker", "--context", context]
    caddy_service = "caddy"

    log "Copying Caddyfile to #{host}:/srv/cast/caddy/Caddyfile"
    run("ssh", host, "mkdir -p /srv/cast/caddy/branches")
    run("scp", File.join(__dir__, "..", "deploy", "caddy", "Caddyfile"), "#{host}:/srv/cast/caddy/Caddyfile")

    container_id = capture(*docker, "ps", "--filter", "name=#{caddy_service}", "--format", "{{.ID}}")
                   .lines(chomp: true).first

    unless container_id
      abort "No running #{caddy_service} container found -- deploy it first with deploy/update-caddy"
    end

    log "Reloading Caddy config (zero-downtime)"
    run(*docker, "exec", container_id, "caddy", "reload", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile")

    log "Reload complete"
  end
end

Dry::CLI.new(Deploy::CLI::Commands).call

# vim:syntax=ruby
