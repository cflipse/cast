#!/usr/bin/env ruby

require "bundler/setup"
require "dry/cli"
require "net/ssh"
require "net/scp"

require "open3"
require "pathname"

module Constants
  REGISTRY_PORT = 5555
  NETWORK = "swarm-network"
  REGISTRY_SERVICE = "registry"
  CADDY_SERVICE = "caddy"
  CAST_ROOT = "/srv/cast"
end

module Shell
  module_function

  def log(message) = puts "==> #{message}"

  def run(*cmd)
    puts "+ #{cmd.join(' ')}"
    system(*cmd) || raise("command failed: #{cmd.join(' ')}")
  end

  # Tag by content (git SHA, same convention bin/deploy uses for app
  # images) so every build gets a distinct tag. A reused static tag (e.g.
  # caddy:bootstrap) makes `docker service update --image` a silent no-op,
  # since Swarm only notices a change when the tag itself differs.
  def image_version
    capture("git", "-C", root, "rev-parse", "--short", "HEAD").strip
  rescue StandardError
    Time.now.to_i.to_s
  end

  def local_image(name) = [name, image_version].join(":")
  def image(*) = "localhost:#{Constants::REGISTRY_PORT}/#{local_image(*)}"

  def success?(*cmd) = system(*cmd, out: File::NULL, err: File::NULL)

  def root(*parts) = Pathname.new(__dir__).join("..", *parts).to_s

  def service_running?(context, name)
    swarm_read(context, "service", "ls", "--format", "{{.Name}}")
      .lines(chomp: true)
      .include?(name)
  end

  def network_running?(context, name)
    swarm_read(context, "network", "ls", "--format", "{{.Name}}")
      .lines(chomp: true)
      .include?(name)
  end

  def docker(*cmd) = run("docker", *cmd)
  def host(context) = capture("docker", "context", "inspect", context, "--format", "{{.Endpoints.docker.Host}}").strip.split("//",2).last

  def swarm(context, *cmd) = run("docker", "--context", context, *cmd)
  def swarm_read(context, *args) = capture("docker", "--context", context, *args)

  def swarm_secrets(context, item)
    existing = swarm_read(context, "secret", "ls",
      "--filter", "label=cast.secrets=#{item}",
      "--format", "{{.Name}}\t{{.Labels}}"
    )

    secrets = existing.lines(chomp: true).to_h do |line|
      sec, labels = line.split("\t", 2)
      [sec, labels.split(",").to_h { it.split("=", 2) }]
    end

    [secrets.keys.max, secrets]
  end

  def capture(*cmd)
    out, status = Open3.capture2(*cmd)
    raise "command failed: #{cmd.join(' ')}" unless status.success?

    out
  end
end

module SSH
  extend self

  def connect(host, &)
    user, hostname = host.split("@", 2)
    user, hostname = "root", user if hostname.nil?

    Net::SSH.start(hostname, user, &)
  end

  def tunnel(ssh, remote_port)
    port = ssh.forward.local(0, "localhost", remote_port)

    running = true
    # keep the connection flowing in the background
    worker = Thread.new { ssh.loop(0.1) { running }}

    begin
      yield port
    ensure
      running = false
      worker.value
    end
  end
end

class SetupDocker < Dry::CLI::Command
  include Shell
  include Constants

  argument :host, required: true, desc: "ssh user@host"
  option :context, default: "cast", desc: "local docker context"

  def call(host:, context:)
    ip = nil
    create_docker_context(host, context)

    SSH.connect(host) do |ssh|
      ip = public_ip(ssh)
      install_docker(ssh)
    end

    docker_swarm_init(context, ip)
    create_overlay_network(context)
    deploy_registry(context)
  end

  private

  def public_ip(ssh)
    ssh.exec!("curl -s http://169.254.169.254/metadata/v1/interfaces/public/0/ipv4/address").strip
  end

  def install_docker(ssh)
    if ssh.exec!("command -v docker").exitstatus == 0
      log "Docker already installed on #{ssh.host}, skipping"
    else
      log "Installing Docker on #{ssh.host}"
      ssh.exec! "curl -fsSL https://get.docker.com | sh"
    end
  end

  def create_docker_context(host, context)
    # Always reset: recreating a context is cheap, and unconditionally
    # doing so avoids a stale context silently pointing at a server that
    # no longer exists (e.g. after swapping in a replacement droplet).
    docker("context", "rm", "-f", context) if success?("docker", "context", "inspect", context)

    log "Creating docker context #{context} -> #{host}"
    docker("context", "create", context, "--docker", "host=ssh://#{host}")
  end

  def docker_swarm_init(context, ip)
    swarm_state = swarm_read(context, "info", "--format", "{{.Swarm.LocalNodeState}}").strip

    if swarm_state == "active"
      log "Already part of a swarm, skipping swarm init"
    else
      log "Initializing swarm"
      swarm(context, "swarm", "init", "--advertise-addr", ip)
    end
  end

  def create_overlay_network(context)
    if network_running?(context, NETWORK)
      log "Network #{NETWORK} already exists, skipping"
    else
      log "Creating overlay network #{NETWORK}"
      swarm(context, "network", "create", "--driver", "overlay", "--attachable", NETWORK)
    end
  end

  def deploy_registry(context)
    if service_running?(context, REGISTRY_SERVICE)
      log "Service #{REGISTRY_SERVICE} already running, skipping"
    else
      log "Deploying registry on 127.0.0.1:#{REGISTRY_PORT}"
      swarm(context, "service", "create",
          "--name", REGISTRY_SERVICE,
          "--network", NETWORK,
          "--publish", "published=#{REGISTRY_PORT},target=5000,mode=host",
          "--constraint", "node.role==manager",
          "--mount", "type=volume,source=registry-data,destination=/var/lib/registry",
          "registry:2")
    end
  end
end

class DeployCaddy < Dry::CLI::Command
  include Shell
  include Constants

  desc "deploy a new caddy image"

  option :context, default: "cast", desc: "local docker context"

  def call(context:)
    host = Shell.host(context)
    build_caddy

    SSH.connect(host) do |ssh|
      push_caddyfile(ssh)
      publish(ssh, local_image("caddy"))
    end

    start_caddy(context, image("caddy"))

    log "Caddy update complete"
  end

  private

  def build_caddy
    dir = root("deploy", "caddy")
    name = local_image("caddy")

    # Build on THIS machine, not the VM's daemon, so the host never spends
    # its own CPU/disk compiling images.
    log "Building front-door Caddy image locally (#{name})"
    docker("build", "-t", name, dir)
  end

  def push_caddyfile(ssh)
    dir = root("deploy", "caddy")
    log "Ensuring #{CAST_ROOT}/caddy/branches exists and Caddyfile is current"

    ssh.exec!("mkdir -p #{CAST_ROOT}/caddy/branches")
    ssh.scp.upload!(File.join(dir, "Caddyfile"), "#{CAST_ROOT}/caddy/")
  end


  def publish(ssh, local_image)
    log "Tunneling to the registry and pushing"
    # Local side uses TUNNEL_PORT (not REGISTRY_PORT) since some other
    # process on this machine may already be bound to REGISTRY_PORT.

    begin
      SSH.tunnel(ssh, REGISTRY_PORT) do |port|
        image = "localhost:#{port}/#{local_image}"
        begin
          docker "tag", local_image, image
          docker "push", image 
        ensure
          docker "rm", "-f", image
        end
      end
    end
  end

  def start_caddy(context, remote_image)
    if service_running?(context, "caddy")
      log "Rolling out #{remote_image} to existing caddy service"
      swarm(context, "service", "update", "--image", remote_image, "caddy")
    else
      log "Creating caddy service"
      swarm(context, "service", "create",
          "--name", CADDY_SERVICE,
          "--network", NETWORK,
          "--publish", "published=80,target=80",
          "--publish", "published=443,target=443",
          "--mount", "type=volume,source=caddy-data,destination=/data",
          "--mount", "type=volume,source=caddy-config,destination=/config",
          "--mount", "type=bind,source=#{CAST_ROOT}/caddy/Caddyfile,destination=/etc/caddy/Caddyfile",
          "--mount", "type=bind,source=#{CAST_ROOT}/caddy/branches,destination=/etc/caddy/branches",
          remote_image)
    end
  end
end

class ReloadCaddy < Dry::CLI::Command
  include Shell
  include Constants

  desc "reload a caddy configuration"

  option :context, default: "cast", desc: "local docker context"

  def call(context:)
    host = Shell.host(context)

    SSH.connect(host) do |ssh|
      push_caddyfile(ssh)
    end

    restart_caddy(context)
  end

  private

  def push_caddyfile(ssh)
    dir = root("deploy", "caddy")
    log "Ensuring #{CAST_ROOT}/caddy/branches exists and Caddyfile is current"

    ssh.exec!("mkdir -p #{CAST_ROOT}/caddy/branches")
    ssh.scp.upload!(File.join(dir, "Caddyfile"), "#{CAST_ROOT}/caddy/")
  end

  def restart_caddy(context)
    container_id = swarm_read(context, "ps", "--filter", "name=#{CADDY_SERVICE}", "--format", "{{.ID}}")
      .lines(chomp: true).first

    unless container_id
      abort "No running #{CADDY_SERVICE} container found -- deploy it first with deploy/update-caddy"
    end

    log "Reloading Caddy config (zero-downtime)"
    swarm(context, "exec", container_id, CADDY_SERVICE, "reload", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile")

    log "Reload complete"
  end
end

class Secrets < Dry::CLI::Command
  include Shell
  include Constants

  desc "add secrets to docker swarm"

  option :template, default: "deploy/env.erb", desc: "ERB env template"
  option :context, default: "cast", desc: "local docker context"
  option :dry_run, type: :boolean, default: false, desc: "print keys only, create nothing", aliases: ["-n"]

  def prepare
    require "shellwords"
    require "digest"
    require "erb"
    require "json"
    require "time"
  end

  def call(template:, dry_run:, context:)
    prepare
    host = Shell.host(context)
    config = Deploy::Config.for('staging')

    fields = fetch_fields(config.vault)
    rendered = ERB.new(File.read(root(template)), trim_mode: "-")
                  .result(Renderer.new(fields).binding_for_erb)

    hex = Digest::SHA256.hexdigest(rendered)[..16]

    current, secrets = swarm_secrets(context, config.vault)
    exists = secrets.dig(current, "cast.hash") == hex

    if dry_run
      puts "==> #{hex}"
      rendered.each_line { |line| puts line.sub(/=.*/m, "=<masked>") unless line.start_with?("#") || line.strip.empty? }

      puts "\n==> exists upstream #{current}" if exists
      return
    end

    name = current
    if exists
      log "Secret #{current} (#{hex}) already exists, skipping"
    else
      name = update_secret(context, config.vault, hex, rendered)
    end

    puts "ENV_SECRET=#{name}"
  end

  private

  Renderer = Data.define(:fields) do
    def secret(name) = fields.fetch(name.to_s) { raise KeyError, "Bitwarden item has no custom field #{name.inspect}" }
    def sh(value) = value.to_s.shellescape
    def binding_for_erb = binding
  end

  def fetch_fields(item)
    json = JSON.parse(capture("bw", "get", "item", item))
    (json["fields"] || []).to_h { |f| [f["name"], f["value"]] }
  end

  def update_secret(context, item, hex, rendered)
    name = "#{item.gsub('.', '-')}-#{Time.now.utc.iso8601.gsub(/[:-]/, '')}"
    log "Creating secret #{name}"

    out, status = Open3.capture2e("docker", "--context", context,
      "secret", "create", name,
      "--label", "cast.secrets=#{item}",
      "--label", "cast.hash=#{hex}",
      "-", stdin_data: rendered)

    raise "secret create failed: #{out}" unless status.success?

    name
  end
end

class RenderStack < Dry::CLI::Command
  include Constants
  include Shell

  desc "render the docker compose stack"

  option :context, default: "cast", desc: "local docker context"
  option :dry_run, default: false, type: :boolean, desc: "test the stack render", aliases: ["-n"]

  def prepare
    require "erb"
  end

  def call(context:, dry_run:, config: nil)
    prepare
    config ||= Deploy::Config.for("staging")

    template = File.read(root("deploy", "stack.yml.erb"))

    stack = ERB.new(template, trim_mode: "-").result_with_hash(
      deployment: config.slug,
      image: Shell.image("cast"),
      env_secret: swarm_secrets(context, config.vault).first,
      root_dir: CAST_ROOT,
      network: NETWORK,
    )

    if dry_run
      puts stack
    end
  end
end

module Deploy

  module Config
    extend self

    module Production
      extend self

      def name = "production"
      def vault = "cast.production"
      def slug = "production"
      def domain = "cast.athas.org"
    end

    Staging = Data.define(:name, :slug) do
      def vault = "cast.staging"
      def domain = "#{slug}.cast.athas.org"
    end

    def self.for(name, production: false)
      return Production if production

      slug = branch.to_s.downcase.gsub(/[^[:alnum:]]/, '-')
      Staging.new(name, slug)
    end

    def self.branch = Shell.capture("git", "branch", "--show-current").strip
  end

  module CLI
    module Commands
      extend Dry::CLI::Registry

      class Version < Dry::CLI::Command
        desc "show current version"
        def call(*) = puts "0.1.0"
      end

      class Bootstrap < Dry::CLI::Command
        include Constants

        desc "set up a new server"

        argument :host, required: true, desc: "ssh user@host"
        option :context, default: "cast", desc: "local docker context"

        def call(opts)
          SSH.connect host do |ssh|
            Shell.log "Creating #{CAST_ROOT}"
            ssh.exec! "sudo mkdir -p #{CAST_ROOT} && sudo chown \"$(id -u):$(id -g)\" #{CAST_ROOT}"
          end

          SetupDocker.new.call(host:, context:)
          DeployCaddy.new.call(context:)
        end
      end

      register "version", Version, aliases: ["v", "-v", "--version"]
      register "bootstrap", Bootstrap
      register "swarm install", ::SetupDocker
      register "caddy deploy", ::DeployCaddy
      register "caddy reload", ::ReloadCaddy
      register "secrets sync", ::Secrets
      register "stack render", ::RenderStack
    end
  end
end

Dry::CLI.new(Deploy::CLI::Commands).call

# vim:syntax=ruby
