<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cast</title>

    <%= tag.link(rel: "icon", src: vite_asset_path("images/favicon.ico")) %>

    <%= vite_javascript_tag "application.js" %>
    <%= vite_stylesheet_tag "application.css" %>
    <%= vite_client_tag %>
  </head>
  <body>
    <header id="heading">
      <h1><a href="/">cast.athas.org</a>
    </header>

    <nav id="sitenav">
      <%= link_to "burnt world of athas", "https://athas.org" %>
      <%= link_to "arena", "https://arena.athas.org" %>
      <%= link_to "podcasts", "/" %>
      <%= link_to "profiles", "#" %>
    </nav>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
