<% podcasts.each do |cast| %>
  <article class="podcast">
    <div><%= image_tag cast.image_url if cast.image %></div>
    <section>
      <h2><%= link_to cast.name, routes.path(:podcast, id: cast.slug) %></h2>

      <%= cast.description %>

      <% if cast.latest_episode %>
        <div>

          <h3>Latest Episode</h3>

          <%= link_to cast.latest_episode.name,
            routes.path(:episode, podcast_id: cast.slug, id: cast.latest_episode.uuid) %>

          <%= cast.episode_description %>
        </div>
        <div>
          Hosted by:  <%= cast.hosts.map(&:display_name).join(", ") %>
        </div>
      <% end %>
    </section>
  </article>
<% end %>
